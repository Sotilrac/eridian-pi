# Route ALSA at the card this figurine actually uses.
#
# Generated by deploy/provision.sh from the AUDIO backend; @CARD@ is filled
# in at provision time. Selected by name rather than index so it survives the
# vc4-hdmi codec probing in a different order after an update.
#
# Note there is no volume control here. The PCM5102A has no hardware mixer,
# and the level is set on the MAX9744 over I2C in any case.

pcm.!default {
    type plug
    slave.pcm "hw:CARD=@CARD@,DEV=0"
}

ctl.!default {
    type hw
    card "@CARD@"
}
